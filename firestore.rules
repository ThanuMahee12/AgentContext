rules_version = '2';

// AgentContext access rules.
//
// Deployed 2026-09-18. Before that, /docs was world-readable while holding
// unpublished drafts - anyone could read them. Redeploy with:
//     firebase deploy --only firestore:rules
//
// Design: private data has NO public read path at all. Published pages are
// physically separate documents written by an explicit publish step, so a
// mistake in these rules cannot expose the archive - the rule simply does not
// cover it.

service cloud.firestore {
  match /databases/{database}/documents {

    // Pinned to one address. email_verified is deliberately NOT required: an
    // account created in the console starts unverified, so demanding it would
    // lock out the only legitimate user until they completed a verification
    // mail round-trip.
    //
    // What that check normally defends against is someone self-registering
    // this address through the public accounts:signUp endpoint, which is
    // reachable with the web API key whenever Email/Password is on. Two things
    // close that instead, and both must hold:
    //   1. the account already exists, so signUp returns EMAIL_EXISTS
    //   2. sign-up is switched off in Authentication > Settings > User actions
    // If sign-up is ever re-enabled, put email_verified back.
    // Two roles, deliberately unequal.
    //
    // The owner writes; viewers only read. Capture runs with an owner-level
    // Google credential that bypasses rules entirely, so `allow write` here is
    // about the dashboard, not the pipeline - but keeping viewers read-only
    // means a viewer's compromised session cannot alter or delete the archive.
    function isOwner() {
      return request.auth != null
          && request.auth.token.email == 'thanujan.tech@gmail.com';
    }

    function canView() {
      return request.auth != null
          && request.auth.token.email in [
               'thanujan.tech@gmail.com',
               'jananthini23@gmail.com'
             ];
    }

    // ---- private: sessions ------------------------------------------------
    // Written at projects/{project}/days/{day}/sessions/{id}.
    //
    // The recursive wildcard is load-bearing, not tidiness. The dashboard reads
    // sessions with a COLLECTION GROUP query, and Firestore only authorises one
    // of those against a rule whose match path begins with a recursive
    // wildcard. A rule written against the concrete path
    // /projects/{p}/days/{d}/sessions/{id} permits fetching a session by its
    // full path and still denies the collection-group query - which surfaces as
    // an empty dashboard rather than as a permission error.
    match /{path=**}/sessions/{sessionId} {
      allow read: if canView();
      allow write: if isOwner();
    }

    // Subcollections under a session: parts/ chunks, commands/, files/
    match /projects/{project}/days/{day}/sessions/{sessionId}/{sub=**} {
      allow read: if canView();
      allow write: if isOwner();
    }

    // ---- private: imported legacy markdown notes --------------------------
    // Created by `agentprobe import-notes`. Missing a rule here meant the 119
    // migrated notes were unreadable by the very account they belong to.
    match /notes/{noteId} {
      allow read: if canView();
      allow write: if isOwner();
    }

    // ---- private: context items (links, tickets, notes) -------------------
    match /context/{itemId} {
      allow read: if canView();
      allow write: if isOwner();
    }

    // ---- private: memory --------------------------------------------------
    match /memory/{userId}/{document=**} {
      allow read, write: if isOwner();
    }

    // ---- private: credential INVENTORY ------------------------------------
    // Metadata only - fingerprints, locations, what a key unlocks. Never a
    // secret value. Kept in its own collection so the publish path, which can
    // only read `public`, has no route to it whatsoever.
    match /credentials/{credId} {
      allow read, write: if isOwner();
    }

    // ---- public: the knowledge base ---------------------------------------
    // The site's own content, published from markdown in content/. World
    // readable by design - the same text ships inside the bundle, so keeping
    // it private here would protect nothing while breaking the page.
    // Named `docs`, not `content`: `context` already exists and two
    // collections one letter apart is a mistake waiting to happen in a rules file.
    match /docs/{docId} {
      // Drafts are NOT public. A document reaches the public page only when an
      // admin sets visibility to "published"; anything else is admin-only.
      //
      // Deliberately not keyed on `status`: that is a workflow state the author
      // picks (open, implementing, done), and overloading it to also mean "the
      // world can read this" turns every workflow rename into a security change.
      //
      // This is a per-document condition, so a public list query MUST carry a
      // matching where("visibility","==","published") - an unconstrained getDocs()
      // is rejected outright rather than filtered, which is the behaviour we
      // want: a query that forgets the filter fails loudly instead of leaking.
      allow read: if canView() || resource.data.visibility == 'published';
      allow write: if isOwner();
    }

    // ---- public: curated copies only --------------------------------------
    // Written by the publish flow after redaction review. Nothing here is a
    // reference to a private document - it is a copy of reviewed content.
    match /public/{slug} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Anything not matched above is denied.
  }
}
