{
  "name": "agentcontext-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-fixtures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-content.mjs && node scripts/ensure-fixtures.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/ensure-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-bundle.mjs",
    "content": "node scripts/build-content.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "^11.1.0",
    "framer-motion": "^13.4.0",
    "react": "^18.3.1",
    "react-calendar": "^6.0.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
