# Copy to .env.local to change what `npm run dev` reads from.
#
#   (unset)    local fixtures — offline, fake data, the default
#   firestore  the real database — needs sign-in, reads live sessions
#   empty      no source at all, to see the "not connected" state
#
# Production ignores this entirely: a build always uses Firestore.
# Nothing secret belongs here. Vite inlines VITE_* into the public bundle.
VITE_DATA_SOURCE=firestore
